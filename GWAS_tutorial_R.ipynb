      "source": [
        "# [셀 4] QC 3단계: 상염색체(1~22)만 남기고 MAF < 0.05 제거\n",
        "bim <- read.table(\"HapMap_3_r3_6.bim\", stringsAsFactors = FALSE)\n",
        "writeLines(bim$V2[bim$V1 >= 1 & bim$V1 <= 22], \"snp_1_22.txt\")\n",
        "sh(paste(PLINK, \"--bfile HapMap_3_r3_6 --extract snp_1_22.txt --make-bed --out HapMap_3_r3_7\"))\n",
        "sh(paste(PLINK, \"--bfile HapMap_3_r3_7 --freq --out MAF_check\"))\n",
        "hist(rd(\"MAF_check.frq\")$MAF, breaks = 50, main = \"MAF distribution\", xlab = \"MAF\")\n",
        "sh(paste(PLINK, \"--bfile HapMap_3_r3_7 --maf 0.05 --make-bed --out HapMap_3_r3_8\"))"
      ]
    },
