      "source": [
        "# [셀 7] QC 6단계: 친족관계 (pi-hat > 0.2)\n",
        "sh(paste(PLINK, \"--bfile HapMap_3_r3_10 --extract indepSNP.prune.in --genome --min 0.2 --out pihat_min0.2\"))\n",
        "g <- rd(\"pihat_min0.2.genome\")\n",
        "plot(g$Z0, g$Z1, col = ifelse(g$RT == \"PO\", \"blue\", \"darkgreen\"), pch = 16,\n",
        "     xlim = c(0, 1), ylim = c(0, 1), xlab = \"Z0\", ylab = \"Z1\", main = \"Relatedness\")\n",
        "legend(\"topright\", c(\"PO (parent-offspring)\", \"UN\"), col = c(\"blue\", \"darkgreen\"), pch = 16)\n",
        "\n",
        "# 부모-자식 관계가 대부분 -> founder(부모가 데이터에 없는 사람)만 남김\n",
        "sh(paste(PLINK, \"--bfile HapMap_3_r3_10 --filter-founders --make-bed --out HapMap_3_r3_11\"))\n",
        "sh(paste(PLINK, \"--bfile HapMap_3_r3_11 --extract indepSNP.prune.in --genome --min 0.2 --out pihat_min0.2_in_founders\"))\n",
        "pairs <- rd(\"pihat_min0.2_in_founders.genome\")\n",
        "print(pairs[, c(\"FID1\", \"IID1\", \"FID2\", \"IID2\", \"Z0\", \"Z1\", \"PI_HAT\")])\n",
        "\n",
        "# 남은 쌍마다 call rate 낮은(결측 많은) 사람 제거. 튜토리얼 정답은 13291 NA07045\n",
        "sh(paste(PLINK, \"--bfile HapMap_3_r3_11 --missing\"))\n",
        "im <- rd(\"plink.imiss\"); miss <- setNames(im$F_MISS, im$IID)\n",
        "drop <- do.call(rbind, lapply(seq_len(nrow(pairs)), function(i) {\n",
        "  p <- pairs[i, ]\n",
        "  if (miss[p$IID1] >= miss[p$IID2]) data.frame(FID = p$FID1, IID = p$IID1) else data.frame(FID = p$FID2, IID = p$IID2)\n",
        "}))\n",
        "print(drop)\n",
        "write.table(drop, \"0.2_low_call_rate_pihat.txt\", quote = FALSE, row.names = FALSE, col.names = FALSE)\n",
        "sh(paste(PLINK, \"--bfile HapMap_3_r3_11 --remove 0.2_low_call_rate_pihat.txt --make-bed --out HapMap_3_r3_12\"))"
      ]
    },
