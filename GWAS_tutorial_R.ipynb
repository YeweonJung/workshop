      "source": [
        "# [셀 5] QC 4단계: Hardy-Weinberg 평형 (대조군 1e-6, 전체 1e-10)\n",
        "sh(paste(PLINK, \"--bfile HapMap_3_r3_8 --hardy\"))\n",
        "hwe <- rd(\"plink.hwe\")\n",
        "hist(-log10(pmax(hwe$P, 1e-300)), breaks = 50, main = \"HWE -log10(P)\", xlab = \"-log10(P)\")\n",
        "sh(paste(PLINK, \"--bfile HapMap_3_r3_8 --hwe 1e-6 --make-bed --out HapMap_hwe_filter_step1\"))\n",
        "sh(paste(PLINK, \"--bfile HapMap_hwe_filter_step1 --hwe 1e-10 --hwe-all --make-bed --out HapMap_3_r3_9\"))"
      ]
