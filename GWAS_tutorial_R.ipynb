      "source": [
        "# GWAS 튜토리얼 실습 (R 런타임)\n",
        "\n",
        "Marees et al. 2018 GWAS 튜토리얼(https://github.com/MareesAT/GWA_tutorial)의 QC → 집단구조 보정 → 연관분석 → Manhattan/QQ plot, 그리고 PRSice-2 예제 PRS까지.\n",
        "\n",
      
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "945SAhj95XHI",
        "outputId": "c04f7c80-80db-40b4-ad07-0dbe76086e85"
      },
      "execution_count": 1,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "PLINK v1.90b7.2 64-bit (11 Dec 2023)\n",
            "사람 수: 165 \n"
          ]
        }
      ],
      "source": [
        "# [셀 1] 준비: PLINK, PRSice, 튜토리얼 데이터 받기 (2~3분 걸림)\n",
        "WORK <- Sys.getenv(\"GWAS_WORK\", \"/content/gwas\")\n",
        "dir.create(WORK, showWarnings = FALSE, recursive = TRUE)\n",
        "setwd(WORK)\n",
        "options(timeout = 1200)\n",
        "\n",
        "# 명령 실행 + PLINK 로그 중 핵심 줄만 출력\n",
        "sh <- function(cmd, show = TRUE) {\n",
        "  out <- suppressWarnings(system(paste(cmd, \"2>&1\"), intern = TRUE))\n",
        "  st <- attr(out, \"status\")\n",
        "  if (!is.null(st) && st != 0) { cat(tail(out, 30), sep = \"\\n\"); stop(\"명령 실패: \", cmd) }\n",
        "  if (show) {\n",
        "    keep <- grep(\"pass filters|removed|people \\\\(|written to|Error|Warning\", out, value = TRUE)\n",
        "    cat(tail(keep, 6), sep = \"\\n\")\n",
        "  }\n",
        "  invisible(out)\n",
        "}\n",
        "get <- function(url, f) if (!file.exists(f)) download.file(url, f, mode = \"wb\", quiet = TRUE)\n",
        "rd  <- function(f) read.table(f, header = TRUE, stringsAsFactors = FALSE, check.names = FALSE)\n",
        "\n",
        "get(\"https://s3.amazonaws.com/plink1-assets/plink_linux_x86_64_20231211.zip\", \"plink.zip\")\n",
        "get(\"https://github.com/choishingwan/PRSice/releases/download/2.3.5/PRSice_linux.zip\", \"PRSice.zip\")\n",
        "get(\"https://github.com/MareesAT/GWA_tutorial/raw/master/1_QC_GWAS.zip\", \"1_QC_GWAS.zip\")\n",
        "unzip(\"plink.zip\", files = \"plink\", exdir = \".\")\n",
        "unzip(\"PRSice.zip\", exdir = \"prsice\")\n",
        "unzip(\"1_QC_GWAS.zip\", exdir = \".\", junkpaths = TRUE)\n",
        "Sys.chmod(c(\"plink\", \"prsice/PRSice_linux\"), mode = \"0755\")\n",
        "PLINK <- file.path(WORK, \"plink\")\n",
        "cat(sh(paste(PLINK, \"--version\"), show = FALSE), sep = \"\\n\")\n",
        "cat(\"사람 수:\", length(readLines(\"HapMap_3_r3_1.fam\")), \"\\n\")"
      ]
    },
