      "source": [
        "# [셀 12] PRS: PRSice-2 예제 데이터 (base GWAS 요약통계 -> target 집단 점수)\n",
        "# 위 HapMap 분석과는 별개로, PRSice 배포판에 들어 있는 TOY 데이터를 쓴다.\n",
        "setwd(file.path(WORK, \"prsice\"))\n",
        "sh(\"./PRSice_linux --base TOY_BASE_GWAS.assoc --target TOY_TARGET_DATA --binary-target T --stat OR --thread 2 --out toy_prs\", show = FALSE)\n",
        "cat(readLines(\"toy_prs.summary\"), sep = \"\\n\")\n",
        "\n",
        "res <- rd(\"toy_prs.prsice\")\n",
        "best <- which.max(res$R2)\n",
        "options(repr.plot.width = 12, repr.plot.height = 5)\n",
        "barplot(res$R2, names.arg = signif(res$Threshold, 2), las = 2, cex.names = 0.5,\n",
        "        col = ifelse(seq_len(nrow(res)) == best, \"red\", \"steelblue\"),\n",
        "        xlab = \"\", ylab = \"PRS R2\", main = \"PRSice: R2 by P-value threshold\")\n",
        "\n",
        "score <- rd(\"toy_prs.best\")\n",
        "fam <- read.table(\"TOY_TARGET_DATA.fam\", col.names = c(\"FID\", \"IID\", \"PID\", \"MID\", \"SEX\", \"PHENO\"))\n",
        "d <- merge(score, fam[, c(\"IID\", \"PHENO\")], by = \"IID\")\n",
        "options(repr.plot.width = 6, repr.plot.height = 5)\n",
        "boxplot(PRS ~ PHENO, data = d, names = c(\"control\", \"case\"), main = \"PRS by case/control\", ylab = \"PRS\")\n",
        "setwd(WORK)"
      ]
    }
  ]
}
