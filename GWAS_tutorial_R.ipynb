      "source": [
        "# [셀 3] QC 2단계: 성별 불일치 (X 염색체 F값: 여자 <0.2, 남자 >0.8)\n",
        "sh(paste(PLINK, \"--bfile HapMap_3_r3_5 --check-sex\"))\n",
        "sex <- rd(\"plink.sexcheck\")\n",
        "par(mfrow = c(1, 2))\n",
        "hist(sex$F[sex$PEDSEX == 1], breaks = 30, main = \"Men\", xlab = \"F\")\n",
        "hist(sex$F[sex$PEDSEX == 2], breaks = 30, main = \"Women\", xlab = \"F\")\n",
        "par(mfrow = c(1, 1))\n",
        "problem <- sex[sex$STATUS == \"PROBLEM\", ]\n",
        "print(problem)\n",
        "write.table(problem[, c(\"FID\", \"IID\")], \"sex_discrepancy.txt\", quote = FALSE, row.names = FALSE, col.names = FALSE)\n",
        "sh(paste(PLINK, \"--bfile HapMap_3_r3_5 --remove sex_discrepancy.txt --make-bed --out HapMap_3_r3_6\"))"
      ]
    },
