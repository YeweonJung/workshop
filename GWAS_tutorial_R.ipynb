      "source": [
        "# [셀 2] QC 1단계: 결측률 (missingness)\n",
        "sh(paste(PLINK, \"--bfile HapMap_3_r3_1 --missing\"))\n",
        "imiss <- rd(\"plink.imiss\"); lmiss <- rd(\"plink.lmiss\")\n",
        "par(mfrow = c(1, 2))\n",
        "hist(imiss$F_MISS, breaks = 50, main = \"Individual missingness\", xlab = \"F_MISS\")\n",
        "hist(lmiss$F_MISS, breaks = 50, main = \"SNP missingness\", xlab = \"F_MISS\")\n",
        "par(mfrow = c(1, 1))\n",
        "\n",
        "# 느슨한 기준(0.2) -> 엄격한 기준(0.02) 순서로 SNP, 사람 제거\n",
        "sh(paste(PLINK, \"--bfile HapMap_3_r3_1 --geno 0.2  --make-bed --out HapMap_3_r3_2\"))\n",
        "sh(paste(PLINK, \"--bfile HapMap_3_r3_2 --mind 0.2  --make-bed --out HapMap_3_r3_3\"))\n",
        "sh(paste(PLINK, \"--bfile HapMap_3_r3_3 --geno 0.02 --make-bed --out HapMap_3_r3_4\"))\n",
        "sh(paste(PLINK, \"--bfile HapMap_3_r3_4 --mind 0.02 --make-bed --out HapMap_3_r3_5\"))"
      ]
    },
