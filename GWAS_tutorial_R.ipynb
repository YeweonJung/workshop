      "source": [
        "# [셀 11] (선택) 순열검정: chr22 일부 SNP만. 원본은 100만 번인데 여기서는 1만 번\n",
        "b13 <- read.table(\"HapMap_3_r3_13.bim\", stringsAsFactors = FALSE)\n",
        "writeLines(b13$V2[b13$V1 == 22 & b13$V4 >= 21595000 & b13$V4 <= 21605000], \"subset_snp_chr_22.txt\")\n",
        "sh(paste(PLINK, \"--bfile HapMap_3_r3_13 --extract subset_snp_chr_22.txt --make-bed --out HapMap_subset_for_perm\"))\n",
        "sh(paste(PLINK, \"--bfile HapMap_subset_for_perm --assoc --mperm 10000 --out subset_perm_result\"))\n",
        "perm <- rd(\"subset_perm_result.assoc.mperm\")\n",
        "print(perm[order(perm$EMP1), ])   # EMP2 = 다중검정 보정된 p값"
      ]
