      "source": [
        "# [셀 9] 연관 분석: --assoc(카이제곱), --logistic(MDS 10개 보정), --adjust(다중검정 보정)\n",
        "sh(paste(PLINK, \"--bfile HapMap_3_r3_13 --assoc --out assoc_results\"))\n",
        "sh(paste(PLINK, \"--bfile HapMap_3_r3_13 --covar covar_mds.txt --logistic --hide-covar --out logistic_results\"))\n",
        "sh(paste(PLINK, \"--bfile HapMap_3_r3_13 --assoc --adjust --out adjusted_assoc_results\"))\n",
        "\n",
        "logi <- rd(\"logistic_results.assoc.logistic\"); logi <- logi[!is.na(logi$P), ]\n",
        "asc  <- rd(\"assoc_results.assoc\");             asc  <- asc[!is.na(asc$P), ]\n",
        "cat(\"logistic 상위 10개 SNP\\n\")\n",
        "print(head(logi[order(logi$P), c(\"CHR\", \"SNP\", \"BP\", \"OR\", \"P\")], 10))\n",
        "cat(\"\\nBonferroni / FDR 보정 결과 상위 5개\\n\")\n",
        "print(head(rd(\"adjusted_assoc_results.assoc.adjusted\"), 5))"
      ]
    },
