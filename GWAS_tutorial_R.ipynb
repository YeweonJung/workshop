      "source": [
        "# [셀 8] 집단 구조화 보정: MDS 성분 10개 -> 공변량 파일\n",
        "# 원본 튜토리얼은 1000 Genomes(수 GB)와 합쳐 비유럽인을 걸러내는데,\n",
        "# 이 데이터는 이미 EUR만 뽑아둔 것이라 그 단계는 건너뛰고 HapMap 안에서만 MDS를 돌린다.\n",
        "sh(paste(PLINK, \"--bfile HapMap_3_r3_12 --make-bed --out HapMap_3_r3_13\"))\n",
        "sh(paste(PLINK, \"--bfile HapMap_3_r3_13 --extract indepSNP.prune.in --genome --out HapMap_3_r3_13\"))\n",
        "sh(paste(PLINK, \"--bfile HapMap_3_r3_13 --read-genome HapMap_3_r3_13.genome --cluster --mds-plot 10 --out HapMap_3_r3_13_mds\"))\n",
        "mds <- rd(\"HapMap_3_r3_13_mds.mds\")\n",
        "plot(mds$C1, mds$C2, pch = 16, xlab = \"C1\", ylab = \"C2\", main = \"MDS (EUR only)\")\n",
        "write.table(mds[, c(\"FID\", \"IID\", paste0(\"C\", 1:10))], \"covar_mds.txt\", quote = FALSE, row.names = FALSE)"
      ]
    },
