      "source": [
        "# [셀 10] Manhattan plot, QQ plot (기본 R 그래픽)\n",
        "manhattan_plot <- function(d, title) {\n",
        "  d <- d[order(d$CHR, d$BP), ]\n",
        "  ends <- tapply(d$BP, d$CHR, max)\n",
        "  offs <- c(0, cumsum(as.numeric(ends)))[seq_along(ends)]\n",
        "  names(offs) <- names(ends)\n",
        "  x <- d$BP + offs[as.character(d$CHR)]\n",
        "  plot(x, -log10(d$P), pch = 20, cex = 0.4, col = ifelse(d$CHR %% 2 == 1, \"#1f4e79\", \"#7fa7c9\"),\n",
        "       xaxt = \"n\", xlab = \"Chromosome\", ylab = \"-log10(P)\", main = title,\n",
        "       ylim = c(0, max(8, -log10(min(d$P))) + 0.5))\n",
        "  axis(1, at = offs + ends / 2, labels = names(ends), cex.axis = 0.6)\n",
        "  abline(h = -log10(5e-8), col = \"red\")              # genome-wide significance\n",
        "  abline(h = -log10(1e-5), col = \"blue\", lty = 2)    # suggestive\n",
        "}\n",
        "qq_plot <- function(p, title) {\n",
        "  p <- sort(p)\n",
        "  e <- -log10(ppoints(length(p)))\n",
        "  lam <- median(qchisq(p, 1, lower.tail = FALSE)) / qchisq(0.5, 1)\n",
        "  plot(e, -log10(p), pch = 20, cex = 0.5, xlab = \"Expected -log10(P)\", ylab = \"Observed -log10(P)\",\n",
        "       main = sprintf(\"%s (lambda = %.3f)\", title, lam))\n",
        "  abline(0, 1, col = \"red\")\n",
        "}\n",
        "options(repr.plot.width = 14, repr.plot.height = 5)\n",
        "manhattan_plot(logi, \"Manhattan: logistic (MDS 10 covariates)\")\n",
        "manhattan_plot(asc, \"Manhattan: assoc\")\n",
        "options(repr.plot.width = 6, repr.plot.height = 6)\n",
        "qq_plot(logi$P, \"QQ: logistic\")\n",
        "qq_plot(asc$P, \"QQ: assoc\")"
      ]
    },
