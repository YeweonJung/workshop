      "source": [
        "# [셀 6] QC 5단계: 이형접합률이 평균 +-3SD 벗어난 사람 제거 (LD pruning한 SNP로 계산)\n",
        "sh(paste(PLINK, \"--bfile HapMap_3_r3_9 --exclude inversion.txt --range --indep-pairwise 50 5 0.2 --out indepSNP\"))\n",
        "sh(paste(PLINK, \"--bfile HapMap_3_r3_9 --extract indepSNP.prune.in --het --out R_check\"))\n",
        "het <- rd(\"R_check.het\")\n",
        "het$HET_RATE <- (het[[\"N(NM)\"]] - het[[\"O(HOM)\"]]) / het[[\"N(NM)\"]]\n",
        "m <- mean(het$HET_RATE); s <- sd(het$HET_RATE)\n",
        "hist(het$HET_RATE, breaks = 40, main = \"Heterozygosity rate\", xlab = \"HET_RATE\")\n",
        "abline(v = c(m - 3 * s, m + 3 * s), lty = 2, col = \"red\")\n",
        "fail <- het[het$HET_RATE < m - 3 * s | het$HET_RATE > m + 3 * s, ]\n",
        "print(fail[, c(\"FID\", \"IID\", \"HET_RATE\")])\n",
        "write.table(fail[, c(\"FID\", \"IID\")], \"het_fail_ind.txt\", quote = FALSE, row.names = FALSE, col.names = FALSE)\n",
        "sh(paste(PLINK, \"--bfile HapMap_3_r3_9 --remove het_fail_ind.txt --make-bed --out HapMap_3_r3_10\"))"
      ]
    },
